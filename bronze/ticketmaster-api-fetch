# app.py — Ticketmaster raw fetch (GB by env), writes raw JSON to S3
import os, json
from datetime import datetime, timedelta, timezone
import urllib.parse as up
import urllib.request as ur
import boto3

# ----- env -----
COUNTRY = os.environ.get("COUNTRY", "GB")          # only country, no city
S3_BUCKET = os.environ["S3_BUCKET"]                # e.g. eventlake-raw
SECRET_NAME = os.environ.get("TM_SECRET_NAME", "TM_API_KEY")
PAGE_SIZE = int(os.environ.get("PAGE_SIZE", "200"))  # first page only for smoke test

# ----- clients -----
secrets = boto3.client("secretsmanager")
s3 = boto3.client("s3")

BASE_URL = "https://app.ticketmaster.com/discovery/v2/events.json"

def _api_key():
    val = secrets.get_secret_value(SecretId=SECRET_NAME)
    return json.loads(val["SecretString"])["key"]

def fetch_events(country_code="US", page=0, size=20):
    now = datetime.now(timezone.utc)
    end_of_week = now + timedelta(days=7)

    params = {
        "apikey": _api_key(),
        "countryCode": country_code,
        "classificationName": "music",
        "page": page,
        "size": size,
        "startDateTime": now.strftime("%Y-%m-%dT00:00:00Z"),
        "endDateTime": end_of_week.strftime("%Y-%m-%dT23:59:59Z"),
        "sort": "date,asc",
    }
    url = f"{BASE_URL}?{up.urlencode(params, doseq=True, safe=':')}"
    with ur.urlopen(url, timeout=20) as resp:
        body = resp.read()
    return json.loads(body.decode("utf-8"))

def lambda_handler(event, context):
    # first page only (smoke test)
    payload = fetch_events(country_code=COUNTRY, page=0, size=PAGE_SIZE)

    # write raw JSON to S3
    day = datetime.now(timezone.utc).date().isoformat()
    key = f"raw/ticketmaster/date={day}/country={COUNTRY}/first_page.json"
    s3.put_object(
        Bucket=S3_BUCKET,
        Key=key,
        Body=json.dumps(payload, separators=(',', ':')).encode("utf-8"),
        ContentType="application/json"
    )

    count = len(payload.get("_embedded", {}).get("events", []))
    return {
        "status": "ok",
        "country": COUNTRY,
        "events_returned": count,
        "s3_key": key
    }
